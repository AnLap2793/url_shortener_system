APP_PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
TRUSTED_PROXY_HOPS=0

POSTGRES_PORT=5432
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=replace-with-url-safe-random-value
POSTGRES_DB=url_shortener

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Worker: capture chỉ dành cho local/test. Dùng resend ở production.
EMAIL_DELIVERY_MODE=capture
EMAIL_FROM=URL Shortener <verify@example.com>
RESEND_API_KEY=

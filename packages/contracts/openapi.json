  "info": {
    "title": "URL Shortener API",
    "description": "Generated from NestJS DTOs; Better Auth routes are owned by its own handler.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "description": "Canonical actor id — the Better Auth user id string."
          }
        },
        "required": [
          "actorId"
        ]
      },
      "ProblemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ]
      },
      "SignUpRegistrationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "marketer@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegistrationPendingDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verification-pending"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ResendRegistrationVerificationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "marketer@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "VerifyRegistrationEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ]
      },
      "RegistrationVerifiedDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verified"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
